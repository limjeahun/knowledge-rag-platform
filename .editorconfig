root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
ktlint_code_style = ktlint_official
max_line_length = 120

# `in` is the established hexagonal package name and must be escaped in Kotlin.
[src/**/kotlin/**/adapter/in/**/*.kt]
ktlint_standard_package-name = disabled

[src/**/kotlin/**/application/**/port/in/**/*.kt]
ktlint_standard_package-name = disabled
