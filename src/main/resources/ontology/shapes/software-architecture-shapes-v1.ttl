@prefix core: <urn:airag:ontology:knowledge-core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

core:DocumentChunkShape
    a sh:NodeShape ;
    sh:name "Document chunk shape"@en, "문서 청크 형상"@ko ;
    sh:description "Validates the identity, ordering, version, and document ownership of an indexed document chunk."@en,
        "색인되는 문서 청크의 순번, 문서 버전과 소속 문서를 검증한다."@ko ;
    sh:targetClass core:DocumentChunk ;
    sh:property [
        sh:name "Chunk index constraint"@en, "청크 순번 제약"@ko ;
        sh:description "A document chunk has exactly one non-negative ordinal within its document version."@en,
            "문서 청크는 문서 버전 안에서 음수가 아닌 순번을 정확히 하나 가져야 한다."@ko ;
        sh:path core:chunkIndex ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A document chunk must have exactly one non-negative integer chunk index."@en,
            "문서 청크에는 음수가 아닌 정수 청크 순번이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Chunk document version constraint"@en, "청크 문서 버전 제약"@ko ;
        sh:description "A document chunk identifies exactly one positive source document version."@en,
            "문서 청크는 1 이상의 원본 문서 버전을 정확히 하나 식별해야 한다."@ko ;
        sh:path core:documentVersion ;
        sh:datatype xsd:long ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:message "A document chunk must have exactly one document version greater than or equal to 1."@en,
            "문서 청크에는 1 이상의 문서 버전이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Chunk source document constraint"@en, "청크 원본 문서 제약"@ko ;
        sh:description "A document chunk belongs to exactly one resource typed as a source document."@en,
            "문서 청크는 원본 문서 타입의 리소스 정확히 하나에 속해야 한다."@ko ;
        sh:path core:chunkOf ;
        sh:class core:Document ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A document chunk must reference exactly one core:Document through core:chunkOf."@en,
            "문서 청크는 core:chunkOf를 통해 core:Document 정확히 하나를 참조해야 합니다."@ko
    ] .

core:StatementEvidenceShape
    a sh:NodeShape ;
    sh:name "Asserted statement evidence shape"@en, "직접 진술 근거 형상"@ko ;
    sh:description "Validates statement-level provenance that ties an asserted RDF triple to an exact source quote."@en,
        "직접 진술된 RDF 트리플을 정확한 원문 인용과 연결하는 문장 단위 출처 정보를 검증한다."@ko ;
    sh:targetClass core:StatementEvidence ;
    sh:property [
        sh:name "Evidence subject constraint"@en, "근거 주어 제약"@ko ;
        sh:description "The reified statement identifies exactly one IRI subject."@en,
            "구체화된 문장은 IRI 형태의 주어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Statement evidence must identify exactly one IRI as rdf:subject."@en,
            "진술 근거에는 rdf:subject로 IRI가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence predicate constraint"@en, "근거 술어 제약"@ko ;
        sh:description "The reified statement identifies exactly one IRI predicate."@en,
            "구체화된 문장은 IRI 형태의 술어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:predicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Statement evidence must identify exactly one IRI as rdf:predicate."@en,
            "진술 근거에는 rdf:predicate로 IRI가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence object constraint"@en, "근거 목적어 제약"@ko ;
        sh:description "The reified statement identifies exactly one RDF object."@en,
            "구체화된 문장은 RDF 목적어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Statement evidence must identify exactly one rdf:object value."@en,
            "진술 근거에는 rdf:object 값이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence document identifier constraint"@en, "근거 문서 식별자 제약"@ko ;
        sh:description "Evidence identifies one non-empty source document identifier."@en,
            "근거는 비어 있지 않은 원본 문서 식별자를 하나 가져야 한다."@ko ;
        sh:path core:documentId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Statement evidence must contain exactly one non-empty string document identifier."@en,
            "진술 근거에는 비어 있지 않은 문자열 문서 식별자가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence document version constraint"@en, "근거 문서 버전 제약"@ko ;
        sh:description "Evidence identifies one positive version of the source document."@en,
            "근거는 원본 문서의 1 이상 버전을 하나 식별해야 한다."@ko ;
        sh:path core:documentVersion ;
        sh:datatype xsd:long ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
        sh:message "Statement evidence must contain exactly one document version greater than or equal to 1."@en,
            "진술 근거에는 1 이상의 문서 버전이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence chunk identifier constraint"@en, "근거 청크 식별자 제약"@ko ;
        sh:description "Evidence identifies the exact non-empty source chunk containing the quote."@en,
            "근거는 인용문을 포함하는 정확한 원본 청크를 비어 있지 않은 식별자로 지정해야 한다."@ko ;
        sh:path core:chunkId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Statement evidence must contain exactly one non-empty string chunk identifier."@en,
            "진술 근거에는 비어 있지 않은 문자열 청크 식별자가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence quote constraint"@en, "근거 인용문 제약"@ko ;
        sh:description "Evidence preserves one exact, non-empty quote from the identified document chunk."@en,
            "근거는 지정된 문서 청크에서 가져온 정확하고 비어 있지 않은 인용문 하나를 보존해야 한다."@ko ;
        sh:path core:quote ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Statement evidence must contain exactly one non-empty source quote."@en,
            "진술 근거에는 비어 있지 않은 원문 인용문이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence confidence constraint"@en, "근거 신뢰도 제약"@ko ;
        sh:description "Evidence has one extraction confidence value in the inclusive range from 0.0 to 1.0."@en,
            "근거는 0.0 이상 1.0 이하 범위의 추출 신뢰도 값을 하나 가져야 한다."@ko ;
        sh:path core:confidence ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive 0.0 ;
        sh:maxInclusive 1.0 ;
        sh:message "Statement evidence confidence must be exactly one xsd:double value between 0.0 and 1.0."@en,
            "진술 근거 신뢰도는 0.0 이상 1.0 이하인 xsd:double 값 정확히 하나여야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Evidence assertion kind constraint"@en, "근거 진술 종류 제약"@ko ;
        sh:description "Evidence explicitly classifies the statement as asserted or inferred."@en,
            "근거는 문장을 직접 진술 또는 추론으로 명시적으로 분류해야 한다."@ko ;
        sh:path core:assertionKind ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("ASSERTED" "INFERRED") ;
        sh:message "Statement evidence assertion kind must be exactly one of ASSERTED or INFERRED."@en,
            "진술 근거의 진술 종류는 ASSERTED 또는 INFERRED 중 정확히 하나여야 합니다."@ko
    ] .

core:InferredStatementProvenanceShape
    a sh:NodeShape ;
    sh:name "Inferred statement provenance shape"@en, "추론 진술 출처 형상"@ko ;
    sh:description "Validates provenance records for statements entailed by the OWL reasoner rather than quoted directly."@en,
        "원문에서 직접 인용하지 않고 OWL 추론기가 도출한 문장의 출처 기록을 검증한다."@ko ;
    sh:targetClass core:InferredStatementProvenance ;
    sh:property [
        sh:name "Inferred subject constraint"@en, "추론 주어 제약"@ko ;
        sh:description "The inferred statement identifies exactly one IRI subject."@en,
            "추론 문장은 IRI 형태의 주어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:subject ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Inferred statement provenance must identify exactly one IRI as rdf:subject."@en,
            "추론 진술 출처에는 rdf:subject로 IRI가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Inferred predicate constraint"@en, "추론 술어 제약"@ko ;
        sh:description "The inferred statement identifies exactly one IRI predicate."@en,
            "추론 문장은 IRI 형태의 술어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:predicate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Inferred statement provenance must identify exactly one IRI as rdf:predicate."@en,
            "추론 진술 출처에는 rdf:predicate로 IRI가 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Inferred object constraint"@en, "추론 목적어 제약"@ko ;
        sh:description "The inferred statement identifies exactly one RDF object."@en,
            "추론 문장은 RDF 목적어를 정확히 하나 식별해야 한다."@ko ;
        sh:path rdf:object ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Inferred statement provenance must identify exactly one rdf:object value."@en,
            "추론 진술 출처에는 rdf:object 값이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Inference ontology version constraint"@en, "추론 온톨로지 버전 제약"@ko ;
        sh:description "The provenance record identifies the exact ontology version used for entailment."@en,
            "출처 기록은 추론에 사용한 정확한 온톨로지 버전을 식별해야 한다."@ko ;
        sh:path core:ontologyVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minLength 1 ;
        sh:message "Inferred statement provenance must contain exactly one non-empty ontology version."@en,
            "추론 진술 출처에는 비어 있지 않은 온톨로지 버전이 정확히 하나 있어야 합니다."@ko
    ] ;
    sh:property [
        sh:name "Inferred assertion kind constraint"@en, "추론 진술 종류 제약"@ko ;
        sh:description "An inferred provenance record is always classified with the fixed value INFERRED."@en,
            "추론 출처 기록은 항상 고정값 INFERRED로 분류해야 한다."@ko ;
        sh:path core:assertionKind ;
        sh:hasValue "INFERRED" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Inferred statement provenance must contain exactly one assertion kind with value INFERRED."@en,
            "추론 진술 출처에는 값이 INFERRED인 진술 종류가 정확히 하나 있어야 합니다."@ko
    ] .
