@prefix core: <urn:airag:ontology:knowledge-core#> .
@prefix soft: <urn:airag:ontology:software-architecture#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:airag:ontology:software-architecture>
    a owl:Ontology ;
    owl:versionIRI <urn:airag:ontology:software-architecture:1.0.0> ;
    owl:versionInfo "1.0.0" ;
    owl:imports <urn:airag:ontology:knowledge-core> ;
    rdfs:label "AIRAG Software Architecture Ontology"@en ;
    rdfs:label "AIRAG 소프트웨어 아키텍처 온톨로지"@ko ;
    rdfs:comment "OWL 2 ontology for software architecture knowledge extracted by AIRAG."@en ;
    rdfs:comment "AIRAG가 문서에서 추출한 소프트웨어 아키텍처 지식을 표현하는 OWL 2 온톨로지다."@ko ;
    skos:definition "The domain ontology that formalizes software technologies, components, processes, stores, and their architectural relationships."@en .

soft:Technology
    a owl:Class ;
    rdfs:subClassOf core:KnowledgeEntity ;
    core:code "TECHNOLOGY" ;
    core:extractable true ;
    rdfs:label "Technology"@en ;
    rdfs:label "기술"@ko ;
    rdfs:comment "A framework, library, protocol, language, model, or technical product."@en ;
    rdfs:comment "프레임워크, 라이브러리, 프로토콜, 언어, 모델 또는 기술 제품을 나타낸다."@ko ;
    skos:definition "A named technical capability or product used to build or operate a software system."@en ;
    skos:example "Spring Boot"@en .

soft:Framework
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "FRAMEWORK" ;
    core:extractable true ;
    rdfs:label "Framework"@en ;
    rdfs:label "프레임워크"@ko ;
    rdfs:comment "A reusable software foundation that supplies structure, conventions, and lifecycle control."@en ;
    rdfs:comment "구조, 규약과 실행 생명주기를 제공하는 재사용 가능한 소프트웨어 기반을 나타낸다."@ko ;
    skos:definition "A technology that provides an extensible application structure and typically controls execution flow."@en ;
    skos:example "Spring Boot"@en .

soft:Library
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "LIBRARY" ;
    core:extractable true ;
    rdfs:label "Library"@en ;
    rdfs:label "라이브러리"@ko ;
    rdfs:comment "A reusable collection of code called by an application to perform a technical capability."@en ;
    rdfs:comment "애플리케이션이 기술 기능을 수행하기 위해 호출하는 재사용 가능한 코드 집합을 나타낸다."@ko ;
    skos:definition "A technology consumed through an API without owning the surrounding application lifecycle."@en ;
    skos:example "Apache Jena"@en .

soft:Protocol
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "PROTOCOL" ;
    core:extractable true ;
    rdfs:label "Protocol"@en ;
    rdfs:label "프로토콜"@ko ;
    rdfs:comment "A defined interaction contract for exchanging messages or invoking capabilities."@en ;
    rdfs:comment "메시지를 교환하거나 기능을 호출하기 위해 정의한 상호작용 계약을 나타낸다."@ko ;
    skos:definition "A technology specification governing communication syntax, semantics, and behavior."@en ;
    skos:example "MCP Streamable HTTP"@en .

soft:ProgrammingLanguage
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "PROGRAMMING_LANGUAGE" ;
    core:extractable true ;
    rdfs:label "Programming language"@en ;
    rdfs:label "프로그래밍 언어"@ko ;
    rdfs:comment "A formal language used to express executable software behavior."@en ;
    rdfs:comment "실행 가능한 소프트웨어 동작을 표현하는 형식 언어를 나타낸다."@ko ;
    skos:definition "A technology whose grammar and semantics define programs executable by a computing platform."@en ;
    skos:example "Kotlin"@en .

soft:AiModel
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "AI_MODEL" ;
    core:extractable true ;
    rdfs:label "AI model"@en ;
    rdfs:label "AI 모델"@ko ;
    rdfs:comment "A named machine-learning model used for embedding, extraction, generation, or reasoning support."@en ;
    rdfs:comment "임베딩, 추출, 생성 또는 추론 지원에 사용하는 이름이 있는 머신러닝 모델을 나타낸다."@ko ;
    skos:definition "A trained computational model invoked to transform or generate information."@en ;
    skos:example "nomic-embed-text"@en .

soft:Component
    a owl:Class ;
    rdfs:subClassOf core:KnowledgeEntity ;
    core:code "COMPONENT" ;
    core:extractable true ;
    rdfs:label "System component"@en ;
    rdfs:label "시스템 컴포넌트"@ko ;
    rdfs:comment "A software or system component with a distinct responsibility."@en ;
    rdfs:comment "구분되는 책임을 가진 소프트웨어 또는 시스템 구성요소를 나타낸다."@ko ;
    skos:definition "A deployable or logical part of a system identified by its architectural responsibility."@en ;
    skos:example "Document indexing consumer"@en .

soft:InboundAdapter
    a owl:Class ;
    rdfs:subClassOf soft:Component ;
    core:code "INBOUND_ADAPTER" ;
    core:extractable true ;
    rdfs:label "Inbound adapter"@en ;
    rdfs:label "인바운드 어댑터"@ko ;
    rdfs:comment "A boundary component that translates an external request or event into an application use case call."@en ;
    rdfs:comment "외부 요청이나 이벤트를 애플리케이션 유스케이스 호출로 변환하는 경계 컴포넌트다."@ko ;
    skos:definition "A component through which external actors initiate application behavior."@en ;
    skos:example "REST controller"@en .

soft:ApplicationService
    a owl:Class ;
    rdfs:subClassOf soft:Component ;
    core:code "APPLICATION_SERVICE" ;
    core:extractable true ;
    rdfs:label "Application service"@en ;
    rdfs:label "애플리케이션 서비스"@ko ;
    rdfs:comment "A component that orchestrates one application use case through domain behavior and ports."@en ;
    rdfs:comment "도메인 동작과 포트를 통해 하나의 애플리케이션 유스케이스를 조율하는 컴포넌트다."@ko ;
    skos:definition "A technology-neutral use-case coordinator inside the hexagonal application boundary."@en ;
    skos:example "ProjectKnowledgeGraphService"@en .

soft:OutboundAdapter
    a owl:Class ;
    rdfs:subClassOf soft:Component ;
    core:code "OUTBOUND_ADAPTER" ;
    core:extractable true ;
    rdfs:label "Outbound adapter"@en ;
    rdfs:label "아웃바운드 어댑터"@ko ;
    rdfs:comment "A boundary component that implements an application port using an external technology."@en ;
    rdfs:comment "외부 기술을 이용하여 애플리케이션 포트를 구현하는 경계 컴포넌트다."@ko ;
    skos:definition "A component that translates an internal capability request into an infrastructure operation."@en ;
    skos:example "Fuseki knowledge graph adapter"@en .

soft:Port
    a owl:Class ;
    rdfs:subClassOf soft:Component ;
    core:code "PORT" ;
    core:extractable true ;
    rdfs:label "Application port"@en ;
    rdfs:label "애플리케이션 포트"@ko ;
    rdfs:comment "A technology-independent capability contract at an application boundary."@en ;
    rdfs:comment "애플리케이션 경계에서 기술과 독립적으로 정의한 기능 계약을 나타낸다."@ko ;
    skos:definition "An interface expressing either an inbound use case or an outbound capability required by the application."@en ;
    skos:example "KnowledgeGraphIndexPort"@en .

soft:Process
    a owl:Class ;
    rdfs:subClassOf core:KnowledgeEntity ;
    core:code "PROCESS" ;
    core:extractable true ;
    rdfs:label "Process"@en ;
    rdfs:label "프로세스"@ko ;
    rdfs:comment "A workflow, activity, lifecycle, or ordered business or technical procedure."@en ;
    rdfs:comment "업무 또는 기술 작업의 워크플로, 활동, 생명주기나 순서 있는 절차를 나타낸다."@ko ;
    skos:definition "A sequence or lifecycle of actions performed to achieve a business or technical outcome."@en .

soft:DocumentRegistration
    a owl:Class ;
    rdfs:subClassOf soft:Process ;
    core:code "DOCUMENT_REGISTRATION" ;
    core:extractable true ;
    rdfs:label "Document registration"@en ;
    rdfs:label "문서 등록"@ko ;
    rdfs:comment "The process that accepts a knowledge document and records its source-of-truth state."@en ;
    rdfs:comment "지식 문서를 접수하고 원본 기준 상태를 기록하는 프로세스를 나타낸다."@ko ;
    skos:definition "The workflow that creates a versioned knowledge document and its indexing request."@en .

soft:DocumentIndexing
    a owl:Class ;
    rdfs:subClassOf soft:Process ;
    core:code "DOCUMENT_INDEXING" ;
    core:extractable true ;
    rdfs:label "Document indexing"@en ;
    rdfs:label "문서 색인"@ko ;
    rdfs:comment "The process that chunks, embeds, semantically projects, and indexes a document version."@en ;
    rdfs:comment "문서 버전을 청킹, 임베딩, 의미 프로젝션 및 색인하는 프로세스를 나타낸다."@ko ;
    skos:definition "The asynchronous workflow that creates Milvus and Fuseki search projections from a source document."@en .

soft:KnowledgeRetrieval
    a owl:Class ;
    rdfs:subClassOf soft:Process ;
    core:code "KNOWLEDGE_RETRIEVAL" ;
    core:extractable true ;
    rdfs:label "Knowledge retrieval"@en ;
    rdfs:label "지식 검색"@ko ;
    rdfs:comment "The process that retrieves relevant vector evidence and semantic graph facts for a query."@en ;
    rdfs:comment "질문과 관련된 벡터 근거와 의미 그래프 사실을 조회하는 프로세스를 나타낸다."@ko ;
    skos:definition "The hybrid retrieval workflow that supplies grounded context for search or answer generation."@en .

soft:DataStore
    a owl:Class ;
    rdfs:subClassOf core:KnowledgeEntity ;
    core:code "DATA_STORE" ;
    core:extractable true ;
    rdfs:label "Data store"@en ;
    rdfs:label "데이터 저장소"@ko ;
    rdfs:comment "A database, index, repository, cache, or temporary data store."@en ;
    rdfs:comment "데이터베이스, 인덱스, 리포지토리, 캐시 또는 임시 데이터 저장소를 나타낸다."@ko ;
    skos:definition "A knowledge entity whose primary responsibility is retaining data for later access."@en .

soft:RelationalDatabase
    a owl:Class ;
    rdfs:subClassOf soft:DataStore ;
    core:code "RELATIONAL_DATABASE" ;
    core:extractable true ;
    rdfs:label "Relational database"@en ;
    rdfs:label "관계형 데이터베이스"@ko ;
    rdfs:comment "A data store organized as constrained relational tables and transactions."@en ;
    rdfs:comment "제약이 있는 관계형 테이블과 트랜잭션으로 구성된 데이터 저장소를 나타낸다."@ko ;
    skos:definition "A durable data store based on the relational model and ACID transaction boundaries."@en ;
    skos:example "PostgreSQL"@en .

soft:VectorIndex
    a owl:Class ;
    rdfs:subClassOf soft:DataStore ;
    core:code "VECTOR_INDEX" ;
    core:extractable true ;
    rdfs:label "Vector index"@en ;
    rdfs:label "벡터 인덱스"@ko ;
    rdfs:comment "A data store optimized for similarity search over embedding vectors."@en ;
    rdfs:comment "임베딩 벡터의 유사도 검색에 최적화된 데이터 저장소를 나타낸다."@ko ;
    skos:definition "A rebuildable search index that retrieves semantically similar document chunks."@en ;
    skos:example "Milvus collection"@en .

soft:ProcessingLockStore
    a owl:Class ;
    rdfs:subClassOf soft:DataStore ;
    core:code "PROCESSING_LOCK_STORE" ;
    core:extractable true ;
    rdfs:label "Processing lock store"@en ;
    rdfs:label "처리 락 저장소"@ko ;
    rdfs:comment "A short-lived coordination store used to reduce concurrent duplicate processing."@en ;
    rdfs:comment "동시 중복 처리를 줄이기 위해 짧은 수명의 락을 보관하는 조정 저장소다."@ko ;
    skos:definition "A non-authoritative store for owner-token locks with an explicit expiration time."@en ;
    skos:example "Redis processing lock"@en .

soft:MessageBroker
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "MESSAGE_BROKER" ;
    core:extractable true ;
    rdfs:label "Message broker"@en ;
    rdfs:label "메시지 브로커"@ko ;
    rdfs:comment "A technology that durably transports asynchronous messages between producers and consumers."@en ;
    rdfs:comment "생산자와 소비자 사이에서 비동기 메시지를 내구성 있게 전달하는 기술을 나타낸다."@ko ;
    skos:definition "A communication technology that decouples message publication from message processing."@en ;
    skos:example "Kafka"@en .

soft:ModelRuntime
    a owl:Class ;
    rdfs:subClassOf soft:Technology ;
    core:code "MODEL_RUNTIME" ;
    core:extractable true ;
    rdfs:label "Model runtime"@en ;
    rdfs:label "모델 런타임"@ko ;
    rdfs:comment "A technology that loads and executes local AI models."@en ;
    rdfs:comment "로컬 AI 모델을 적재하고 실행하는 기술을 나타낸다."@ko ;
    skos:definition "An execution environment exposing model inference capabilities to the application."@en ;
    skos:example "Ollama"@en .

soft:partOf
    a owl:ObjectProperty ;
    owl:inverseOf soft:hasPart ;
    rdfs:domain core:KnowledgeEntity ;
    rdfs:range core:KnowledgeEntity ;
    core:code "PART_OF" ;
    core:extractable true ;
    rdfs:label "part of"@en ;
    rdfs:label "일부임"@ko ;
    rdfs:comment "The source is an explicit part or member of the target."@en ;
    rdfs:comment "주어 개체가 목적어 개체의 명시적인 일부 또는 구성원임을 나타낸다."@ko ;
    skos:definition "A meronymic relation from a constituent knowledge entity to the whole that contains it."@en .

soft:hasPart
    a owl:ObjectProperty ;
    rdfs:domain core:KnowledgeEntity ;
    rdfs:range core:KnowledgeEntity ;
    rdfs:label "has part"@en ;
    rdfs:label "일부를 가짐"@ko ;
    rdfs:comment "Relates a whole knowledge entity to an explicit constituent or member."@en ;
    rdfs:comment "전체 지식 개체를 그 개체의 명시적인 구성요소 또는 구성원과 연결한다."@ko ;
    skos:definition "The inverse meronymic relation of partOf, directed from whole to part."@en .

soft:uses
    a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            soft:Technology
            soft:Component
            soft:Process
            core:Organization
            core:Person
        )
    ] ;
    rdfs:range core:KnowledgeEntity ;
    core:code "USES" ;
    core:extractable true ;
    rdfs:label "uses"@en ;
    rdfs:label "사용함"@ko ;
    rdfs:comment "The source explicitly uses the target."@en ;
    rdfs:comment "주어 개체가 목적어 개체를 명시적으로 사용함을 나타낸다."@ko ;
    skos:definition "A broad operational dependency in which an eligible actor or process employs another knowledge entity."@en .

soft:dependsOn
    a owl:ObjectProperty ;
    rdfs:domain core:KnowledgeEntity ;
    rdfs:range core:KnowledgeEntity ;
    core:code "DEPENDS_ON" ;
    core:extractable true ;
    rdfs:label "depends on"@en ;
    rdfs:label "의존함"@ko ;
    rdfs:comment "The source explicitly requires the target."@en ;
    rdfs:comment "주어 개체가 올바르게 존재하거나 동작하기 위해 목적어 개체를 명시적으로 필요로 함을 나타낸다."@ko ;
    skos:definition "A requirement relation whose target is necessary for the source's intended operation or meaning."@en .

soft:produces
    a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            soft:Technology
            soft:Component
            soft:Process
            core:Organization
            core:Person
        )
    ] ;
    rdfs:range core:KnowledgeEntity ;
    core:code "PRODUCES" ;
    core:extractable true ;
    rdfs:label "produces"@en ;
    rdfs:label "생성함"@ko ;
    rdfs:comment "The source explicitly creates, emits, or results in the target."@en ;
    rdfs:comment "주어 개체가 목적어 개체를 명시적으로 만들거나 방출하거나 결과로 산출함을 나타낸다."@ko ;
    skos:definition "An output relation from a technology, component, process, organization, or person to a created knowledge entity."@en .

soft:storesIn
    a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            soft:Component
            soft:Process
            core:Document
            core:DocumentChunk
        )
    ] ;
    rdfs:range soft:DataStore ;
    core:code "STORES_IN" ;
    core:extractable true ;
    rdfs:label "stores in"@en ;
    rdfs:label "저장함"@ko ;
    rdfs:comment "The source data or output is explicitly stored in the target data store."@en ;
    rdfs:comment "주어 개체의 데이터나 출력이 목적어 데이터 저장소에 명시적으로 저장됨을 나타낸다."@ko ;
    skos:definition "A persistence relation from an eligible producer or artifact to the data store retaining its data."@en .

soft:readsFrom
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soft:uses ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (soft:Component soft:Process)
    ] ;
    rdfs:range soft:DataStore ;
    core:code "READS_FROM" ;
    core:extractable true ;
    rdfs:label "reads from"@en ;
    rdfs:label "읽어 옴"@ko ;
    rdfs:comment "States that a component or process reads data from a data store."@en ;
    rdfs:comment "컴포넌트나 프로세스가 데이터 저장소에서 데이터를 읽어 옴을 나타낸다."@ko ;
    skos:definition "A specialized use relation describing data retrieval from a persistent or temporary store."@en .

soft:writesTo
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soft:uses ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (soft:Component soft:Process)
    ] ;
    rdfs:range soft:DataStore ;
    core:code "WRITES_TO" ;
    core:extractable true ;
    rdfs:label "writes to"@en ;
    rdfs:label "기록함"@ko ;
    rdfs:comment "States that a component or process writes data to a data store."@en ;
    rdfs:comment "컴포넌트나 프로세스가 데이터 저장소에 데이터를 기록함을 나타낸다."@ko ;
    skos:definition "A specialized use relation describing a write operation against a data store."@en .

soft:publishesTo
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soft:uses ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (soft:Component soft:Process)
    ] ;
    rdfs:range soft:MessageBroker ;
    core:code "PUBLISHES_TO" ;
    core:extractable true ;
    rdfs:label "publishes to"@en ;
    rdfs:label "발행함"@ko ;
    rdfs:comment "States that a component or process publishes asynchronous messages to a broker."@en ;
    rdfs:comment "컴포넌트나 프로세스가 메시지 브로커로 비동기 메시지를 발행함을 나타낸다."@ko ;
    skos:definition "A specialized use relation from a message producer to the broker receiving its publication."@en .

soft:consumesFrom
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soft:uses ;
    rdfs:domain soft:Component ;
    rdfs:range soft:MessageBroker ;
    core:code "CONSUMES_FROM" ;
    core:extractable true ;
    rdfs:label "consumes from"@en ;
    rdfs:label "소비함"@ko ;
    rdfs:comment "States that a component consumes asynchronous messages from a broker."@en ;
    rdfs:comment "컴포넌트가 메시지 브로커에서 비동기 메시지를 소비함을 나타낸다."@ko ;
    skos:definition "A specialized use relation from a message consumer to the broker delivering its messages."@en .

soft:indexedIn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf soft:storesIn ;
    owl:inverseOf soft:containsIndexedChunk ;
    rdfs:domain core:DocumentChunk ;
    rdfs:range soft:VectorIndex ;
    core:code "INDEXED_IN" ;
    core:extractable true ;
    rdfs:label "indexed in"@en ;
    rdfs:label "색인됨"@ko ;
    rdfs:comment "States that a document chunk is indexed in a vector index."@en ;
    rdfs:comment "문서 청크가 벡터 인덱스에 색인되어 있음을 나타낸다."@ko ;
    skos:definition "A specialized storage relation from a retrievable document chunk to its vector index."@en .

soft:containsIndexedChunk
    a owl:ObjectProperty ;
    rdfs:domain soft:VectorIndex ;
    rdfs:range core:DocumentChunk ;
    rdfs:label "contains indexed chunk"@en ;
    rdfs:label "색인된 청크를 포함함"@ko ;
    rdfs:comment "Relates a vector index to a document chunk currently represented in that index."@en ;
    rdfs:comment "벡터 인덱스를 그 인덱스에 현재 표현된 문서 청크와 연결한다."@ko ;
    skos:definition "The inverse of indexedIn, directed from a vector index to an indexed source fragment."@en .

soft:implementsPort
    a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (soft:InboundAdapter soft:OutboundAdapter)
    ] ;
    rdfs:range soft:Port ;
    core:code "IMPLEMENTS_PORT" ;
    core:extractable true ;
    rdfs:label "implements port"@en ;
    rdfs:label "포트를 구현함"@ko ;
    rdfs:comment "States that an inbound or outbound adapter implements an application port contract."@en ;
    rdfs:comment "인바운드 또는 아웃바운드 어댑터가 애플리케이션 포트 계약을 구현함을 나타낸다."@ko ;
    skos:definition "A hexagonal architecture relation from a boundary adapter to the port whose contract it realizes."@en .

soft:invokesPort
    a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (soft:Component soft:Process)
    ] ;
    rdfs:range soft:Port ;
    core:code "INVOKES_PORT" ;
    core:extractable true ;
    rdfs:label "invokes port"@en ;
    rdfs:label "포트를 호출함"@ko ;
    rdfs:comment "States that a component or process invokes an application port capability."@en ;
    rdfs:comment "컴포넌트나 프로세스가 애플리케이션 포트의 기능을 호출함을 나타낸다."@ko ;
    skos:definition "A behavioral relation from an application participant to the technology-neutral port it calls."@en .
